#!/bin/bash
# vpn [home|away|off|adblock|status|help]
case "${1:-help}" in
home)
  sudo wg-quick down protonvpn 2>/dev/null
  protonvpn disconnect 2>/dev/null
  sudo resolvconf -u 2>/dev/null
  sudo wg-quick up wg-pi
  # ponytail: fail-open guard — Pi's Proton cert expires ~weekly; without this
  # home mode silently exits via the home ISP instead of via Proton
  AGE=$(ssh -o ConnectTimeout=8 tom 'sudo wg show protonvpn latest-handshakes' 2>/dev/null | awk '{print $2}' | head -1)
  if [[ -z ${AGE:-} || ${AGE:-999999} -gt 180 ]]; then
    echo "WARN: Pi's Proton tunnel is down/stale — traffic is exiting via the home ISP. Run vpn-sync-pi."
    exit 1
  fi
  ;;
away)
  sudo wg-quick down wg-pi 2>/dev/null
  protonvpn connect 2>&1 | tail -3
  if ! ip route get 1.1.1.1 2>/dev/null | grep -q 'dev proton0'; then
    echo "WARN: not routing through Proton - traffic is going via $(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}')"
    exit 1
  fi
  ;;
off)
  sudo wg-quick down wg-pi 2>/dev/null
  protonvpn disconnect 2>/dev/null
  echo "VPN off — using bare internet"
  ;;
adblock|ads)
  shift
  exec "$HOME/.local/bin/vpn-adblock" "${@:-status}"
  ;;
status)
  curl -s --max-time 5 https://ipinfo.io/json 2>/dev/null | python3 -c "
import sys,json
d=json.load(sys.stdin)
print(f\"IP: {d['ip']}  ({d['city']}, {d['country']})\")" 2>/dev/null
  sudo wg show 2>/dev/null | grep -E "interface|latest" | head -10
  printf "Ad-block DNS: %s\n" "$(ssh -o ConnectTimeout=4 raspberrypi 'systemctl is-active dnsmasq' 2>/dev/null || echo unreachable)"
  ;;
help)
  printf "home\n"
  printf "away\n"
  printf "off\n"
  printf "adblock [setup|update|on|off|status]\n"
  printf "status\n"
  ;;
esac
