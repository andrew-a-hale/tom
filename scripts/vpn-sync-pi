#!/bin/bash
# Refresh the Pi's Proton WireGuard config when the cert expires (~weekly).
# Usage: vpn-sync-pi
set -e

echo "Getting fresh Proton config..."

# Connect via Proton daemon (gets fresh certificate + WireGuard key)
sudo wg-quick down wg-pi 2>/dev/null || true
protonvpn connect 2>&1 | tail -3

# Find the Proton WireGuard interface (daemon names it proton0/protonvpn/tun0)
# ponytail: match by name, not by excluding everything else — the old heuristic
# grabbed unrelated interfaces like a down ethernet port
IFACE=$(ip -br link show 2>/dev/null | awk '$1 ~ /^proton|^tun/ {print $1; exit}')

if [[ -z "$IFACE" ]]; then
    # Fallback: try common names
    for try in protonvpn proton0 tun0; do
        wg show "$try" >/dev/null 2>&1 && IFACE="$try" && break
    done
fi

if [[ -z "$IFACE" ]]; then
    echo "ERROR: Could not find Proton WireGuard interface"
    exit 1
fi

echo "Found Proton interface: $IFACE"

# Extract config
PRIVKEY=$(sudo wg show "$IFACE" private-key)
ENDPOINT=$(sudo wg show "$IFACE" endpoints | awk '{print $2}')
PEER_PUB=$(sudo wg show "$IFACE" peers)

# Push to Pi
echo "Pushing to Pi..."
ssh tom "sudo tee /etc/wireguard/protonvpn.conf > /dev/null" << EOF
[Interface]
PrivateKey = $PRIVKEY
Address = 10.2.0.2/32
DNS = 10.2.0.1

[Peer]
PublicKey = $PEER_PUB
AllowedIPs = 0.0.0.0/0
Endpoint = $ENDPOINT
PersistentKeepalive = 25
EOF

# Reload Pi's Proton tunnel
# Reload Pi's Proton tunnel
# ponytail: systemctl restart, not `wg syncconf <(...)` — process substitution
# breaks through ssh+sudo (fopen error) and its failure was swallowed by the
# && chain; restart is one shot and idempotent whether the tunnel is up or down
ssh tom 'sudo systemctl restart wg-quick@protonvpn' && \
    echo "Pi tunnel refreshed."

# Disconnect Proton on laptop, reconnect to Pi
protonvpn disconnect 2>&1 | tail -1
sudo wg-quick up wg-pi 2>&1 | tail -1
echo "Back on Pi VPN."
